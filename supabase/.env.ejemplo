# Plantilla del entorno de supabase/scripts/medir-latencia.js. Cópiala como supabase/.env.local (Supabase
# local) o supabase/.env.remoto (proyecto remoto) y rellénala. Esas copias están en .gitignore: nunca
# subas una con valores. No va aquí la clave de servicio ni la contraseña de la base de datos.

# URL de la API: http://127.0.0.1:54321 en local (API_URL de `npx supabase status`);
# https://<project-ref>.supabase.co en remoto (Project Settings > API)
SUPABASE_URL=

# Clave pública (publishable o anon): PUBLISHABLE_KEY de `npx supabase status`, o la del panel en remoto
SUPABASE_PUBLISHABLE_KEY=

# Usuario A, el que escribe (dueño del diagrama de la medida). En remoto, créalo en el panel con "Auto confirm";
# en local el script lo registra si no existe
MEDIR_A_CORREO=
MEDIR_A_PASSWORD=

# Usuario B, el que recibe por Realtime (lector del diagrama)
MEDIR_B_CORREO=
MEDIR_B_PASSWORD=
